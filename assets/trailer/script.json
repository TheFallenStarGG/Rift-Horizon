    { "id": "r03", "voice": "radio",    "at": 43.0, "text": "Drone's up. I've got eyes on the field.", "stability": 0.3, "style": 0.4, "speed": 1.05 },
    { "id": "n05", "voice": "narrator", "at": 47.2, "text": "And some things... defy explanation.", "stability": 0.4, "style": 0.6 },
