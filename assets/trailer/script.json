  "lines": [
    { "id": "n01", "voice": "narrator", "at": 1.0,  "text": "Every world has a breaking point.", "stability": 0.4, "style": 0.55 },
    { "id": "n02", "voice": "narrator", "at": 3.5,  "text": "And someone always arrives to find it.", "stability": 0.4, "style": 0.55 },
    { "id": "r01", "voice": "radio",    "at": 7.0,  "text": "Dropship's over the zone. Green light. Go, go, go!", "stability": 0.3, "style": 0.4, "speed": 1.1 },
    { "id": "r02", "voice": "radio",    "at": 13.0, "text": "Chutes! Pull your chutes!", "stability": 0.3, "style": 0.4, "speed": 1.1 },
    { "id": "r03", "voice": "radio",    "at": 17.2, "text": "Boots down. Weapons free.", "stability": 0.3, "style": 0.4, "speed": 1.05 },
    { "id": "r04", "voice": "radio",    "at": 20.6, "text": "Contact front! All units, engage!", "stability": 0.3, "style": 0.4, "speed": 1.1 },
    { "id": "r05", "voice": "radio",    "at": 22.9, "text": "Reloading! Cover me!", "stability": 0.3, "style": 0.4, "speed": 1.1 },
    { "id": "n03", "voice": "narrator", "at": 24.4, "text": "Every weapon has a voice.", "stability": 0.4, "style": 0.6 },
    { "id": "n04", "voice": "narrator", "at": 30.3, "text": "And some of them carry a secret.", "stability": 0.4, "style": 0.6 },
    { "id": "n05", "voice": "narrator", "at": 38.3, "text": "Abilities that bend the rules.", "stability": 0.4, "style": 0.6 },
    { "id": "n06", "voice": "narrator", "at": 46.4, "text": "Blades that cut through anything.", "stability": 0.4, "style": 0.6 },
    { "id": "n07", "voice": "narrator", "at": 52.4, "text": "Eyes in the sky. Fate in a single round.", "stability": 0.4, "style": 0.6 },
    { "id": "n08", "voice": "narrator", "at": 56.4, "text": "Take the wheel.", "stability": 0.4, "style": 0.6 },
    { "id": "r06", "voice": "radio",    "at": 59.2, "text": "Truck's moving. Take it out!", "stability": 0.3, "style": 0.4, "speed": 1.1 },
    { "id": "n09", "voice": "narrator", "at": 66.3, "text": "Or take to the sky.", "stability": 0.4, "style": 0.6 },
    { "id": "r07", "voice": "radio",    "at": 70.5, "text": "Bird's inbound. Cover the landing zone!", "stability": 0.3, "style": 0.4, "speed": 1.05 },
    { "id": "n10", "voice": "narrator", "at": 74.3, "text": "Build. Break. Rebuild.", "stability": 0.4, "style": 0.6 },
    { "id": "r08", "voice": "radio",    "at": 79.0, "text": "Walls up! Hold this position!", "stability": 0.3, "style": 0.4, "speed": 1.1 },
    { "id": "n11", "voice": "narrator", "at": 83.0, "text": "Every second counts.", "stability": 0.35, "style": 0.65 },
    { "id": "n12", "voice": "narrator", "at": 86.6, "text": "This is where legends are made.", "stability": 0.35, "style": 0.65 },
    { "id": "r09", "voice": "radio",    "at": 91.2, "text": "All units, push! Push!", "stability": 0.3, "style": 0.4, "speed": 1.1 },
    { "id": "n13", "voice": "narrator", "at": 99.0, "text": "Rift Horizon.", "stability": 0.3, "style": 0.7 }
