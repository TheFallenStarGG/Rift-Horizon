{
  "name": "rift-horizon",
  "version": "0.4.0",
  "description": "Rift Horizon desktop",
  "main": "main.js",
  "author": "TheFallenStarGG",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -mwl"
  },
  "build": {
    "appId": "gg.thefallenstar.rifthorizon",
    "productName": "Rift Horizon",
    "copyright": "Copyright TheFallenStarGG",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../_game_stage",
        "to": "game"
      }
    ],
    "icon": "../favicon.png",
    "win": {
      "icon": "../favicon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "RiftHorizon-${version}-Windows-Portable-x64.exe"
    },
    "nsis": {
      "artifactName": "RiftHorizon-${version}-Windows-Setup-Installer-x64.exe",
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rift Horizon"
    },
    "mac": {
      "icon": "../favicon.png",
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "artifactName": "RiftHorizon-${version}-macOS-${arch}.dmg",
      "title": "Rift Horizon ${version}"
    },
    "linux": {
      "icon": "../favicon.png",
      "category": "Game",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    },
    "appImage": {
      "artifactName": "RiftHorizon-${version}-Linux-x64.AppImage"
    },
    "deb": {
      "artifactName": "RiftHorizon-${version}-Linux-x64.deb",
      "depends": []
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
